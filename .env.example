# Пример имён переменных; НЕ помещай сюда реальные ключи.
# Основной провайдер: Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Резервный провайдер: Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Если HTML обслуживается другим локальным адресом (не file://), укажи точный Origin.
# По умолчанию CORS закрыт; backend загружает .env из корня проекта при старте.
CLARIFY_CORS_ORIGINS=
